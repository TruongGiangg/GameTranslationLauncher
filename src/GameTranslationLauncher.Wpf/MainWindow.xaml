<Window x:Class="GameTranslationLauncher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:GameTranslationLauncher.Wpf.Views"
        mc:Ignorable="d"
        Title="TG Launcher"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="720"
        Background="{StaticResource BrushBackground}"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                           CornerRadius="0"
                           GlassFrameThickness="0"
                           ResizeBorderThickness="6"
                           UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource BrushBackground}"
            BorderThickness="0"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="{StaticResource BrushBackground}"
                  MouseLeftButtonDown="TitleBarMouseLeftButtonDown">
                <TextBlock Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="TG LAUNCHER" />
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Click="MinimizeButtonClick"
                            Content="—"
                            Style="{StaticResource WindowCommandButton}"
                            ToolTip="{Binding Settings.Text.Application.MinimizeTooltip}" />
                    <Button Click="MaximizeButtonClick"
                            Content="▢"
                            Style="{StaticResource WindowCommandButton}"
                            ToolTip="{Binding Settings.Text.Application.MaximizeTooltip}" />
                    <Button Click="CloseButtonClick"
                            Content="X"
                            Style="{StaticResource WindowCommandButton}"
                            ToolTip="{Binding Settings.Text.Application.CloseTooltip}" />
                </StackPanel>
            </Grid>

            <views:GameLibraryView Grid.Row="1" />
        </Grid>
    </Border>
</Window>
