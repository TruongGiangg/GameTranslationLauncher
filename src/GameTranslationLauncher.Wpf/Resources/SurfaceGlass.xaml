<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Surface "glass": the hero runs under the whole window; top-level panes (GlassBorder) draw a
         pre-blurred copy of it, then these light fills. Nested surfaces are plain light fills, no blur. -->
    <SolidColorBrush x:Key="BrushBackground" Color="#101114" />
    <SolidColorBrush x:Key="BrushTitleBar" Color="Transparent" />
    <SolidColorBrush x:Key="BrushTitleText" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="BrushSidebar" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="BrushSidebarBorder" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="BrushPanel" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="BrushBorder" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="BrushStatBorder" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="#BDFFFFFF" />
    <SolidColorBrush x:Key="BrushHeroBody" Color="#EBFFFFFF" />
    <SolidColorBrush x:Key="BrushField" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="BrushPopup" Color="#F2232429" />
    <SolidColorBrush x:Key="BrushCard" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="BrushCardStrong" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="BrushModal" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="BrushModalBorder" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="BrushModalOverlay" Color="#33000000" />
    <SolidColorBrush x:Key="BrushLoadingOverlay" Color="#59000000" />
    <SolidColorBrush x:Key="BrushDialog" Color="#B31C1D21" />
    <SolidColorBrush x:Key="BrushChip" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="BrushChipBorder" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="BrushNotice" Color="#33FFC86E" />
    <SolidColorBrush x:Key="BrushNoticeBorder" Color="#59FFD27A" />
    <SolidColorBrush x:Key="BrushDivider" Color="Transparent" />
    <SolidColorBrush x:Key="BrushDock" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="BrushDockBorder" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="BrushGameItemBorder" Color="Transparent" />
    <SolidColorBrush x:Key="BrushGameItemSelected" Color="#33FFFFFF" />
    <LinearGradientBrush x:Key="BrushHeroFade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#2E08090A" />
        <GradientStop Offset="0.22" Color="#0008090A" />
        <GradientStop Offset="0.55" Color="#0008090A" />
        <GradientStop Offset="1" Color="#4708090A" />
    </LinearGradientBrush>

    <Thickness x:Key="LibraryMargin">0</Thickness>
    <Thickness x:Key="SidebarMargin">14,52,0,14</Thickness>
    <Thickness x:Key="SidebarBorderThickness">1</Thickness>
    <Thickness x:Key="DetailsContentMargin">196,42,28,26</Thickness>
    <Thickness x:Key="DividerMargin">0,18,0,0</Thickness>
    <Thickness x:Key="DockBorderThickness">1</Thickness>
    <!-- Bottom is tighter: the dock's last row is an operation message line that is often empty. -->
    <Thickness x:Key="DockPadding">22,20,22,8</Thickness>

    <CornerRadius x:Key="RadiusSidebar">26</CornerRadius>
    <CornerRadius x:Key="RadiusCard">16</CornerRadius>
    <CornerRadius x:Key="RadiusButton">14</CornerRadius>
    <CornerRadius x:Key="RadiusDock">28</CornerRadius>
    <CornerRadius x:Key="RadiusModal">28</CornerRadius>
    <CornerRadius x:Key="RadiusDialog">24</CornerRadius>
    <CornerRadius x:Key="RadiusNotice">16</CornerRadius>
    <CornerRadius x:Key="RadiusGameItem">16</CornerRadius>

    <sys:Int32 x:Key="DetailsColumn">0</sys:Int32>
    <sys:Int32 x:Key="DetailsColumnSpan">2</sys:Int32>
    <sys:Double x:Key="GameItemOpacity">1</sys:Double>
    <sys:Double x:Key="GameItemHoverOpacity">1</sys:Double>
</ResourceDictionary>
