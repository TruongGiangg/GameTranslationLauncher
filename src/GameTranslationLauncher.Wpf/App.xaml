<Application x:Class="GameTranslationLauncher.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameTranslationLauncher.Wpf"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the surface (glass/dark) and is replaced at runtime by LauncherThemeManager. -->
                <ResourceDictionary Source="Resources/SurfaceGlass.xaml" />
                <ResourceDictionary Source="Resources/LauncherTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
