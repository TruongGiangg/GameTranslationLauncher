<UserControl x:Class="GameTranslationLauncher.Wpf.Views.GameDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:GameTranslationLauncher.Wpf.Controls"
             xmlns:services="clr-namespace:GameTranslationLauncher.Wpf.Services">
    <Grid x:Name="HeroHost" ClipToBounds="True">
        <Rectangle x:Name="HeroFallback" Fill="{Binding Details.HeroBrush}" />
        <Image x:Name="HeroPrevious" Stretch="Fill" RenderTransformOrigin="0.5,0.5" />
        <Image x:Name="HeroCurrent"
               Source="{Binding Details.HeroImage, NotifyOnTargetUpdated=True}"
               TargetUpdated="HeroTargetUpdated"
               Stretch="Fill"
               RenderTransformOrigin="0.5,0.5" />
        <Rectangle Fill="{DynamicResource BrushHeroFade}" />

        <!-- Ambilight: the game's ambient colour glows in from every window edge. The glow brush is transparent
             outside Glassy, so the dark surface is unaffected; colour changes animate with the brush. -->
        <Grid IsHitTestVisible="False">
            <Rectangle Height="160" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="{Binding Color, Source={x:Static services:GlassBackdrop.GlowBrush}}" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Height="160" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Offset="0" Color="{Binding Color, Source={x:Static services:GlassBackdrop.GlowBrush}}" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="200" HorizontalAlignment="Left">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="{Binding Color, Source={x:Static services:GlassBackdrop.GlowBrush}}" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="200" HorizontalAlignment="Right">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                        <GradientStop Offset="0" Color="{Binding Color, Source={x:Static services:GlassBackdrop.GlowBrush}}" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <Grid Margin="{DynamicResource DetailsContentMargin}" VerticalAlignment="Bottom">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,16,0">
                    <Image Source="{Binding Details.LogoImage, NotifyOnTargetUpdated=True}"
                           TargetUpdated="TitleTargetUpdated"
                           MaxHeight="140"
                           MaxWidth="560"
                           HorizontalAlignment="Left"
                           Stretch="Uniform"
                           AutomationProperties.Name="{Binding Details.DisplayName}"
                           Visibility="{Binding Details.HasLogoImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Image.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.65" />
                        </Image.Effect>
                    </Image>
                    <TextBlock HorizontalAlignment="Left"
                               Foreground="White"
                               FontSize="{Binding Details.DisplayNameFontSize}"
                               FontWeight="ExtraBold"
                               Text="{Binding Details.DisplayName, NotifyOnTargetUpdated=True}"
                               TargetUpdated="TitleTargetUpdated"
                               TextAlignment="Left"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Details.HasLogoImage}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <controls:GlassBorder Grid.Column="1"
                                      Padding="16,8"
                                      VerticalAlignment="Top"
                                      Background="{DynamicResource BrushChip}"
                                      BorderBrush="{DynamicResource BrushChipBorder}"
                                      BorderThickness="1"
                                      CornerRadius="20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,7,0"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   FontWeight="Bold"
                                   Text="{Binding Details.StatusGlyph}" />
                        <TextBlock Foreground="{DynamicResource BrushTextPrimary}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Text="{Binding Details.StatusLabel}" />
                    </StackPanel>
                </controls:GlassBorder>
            </Grid>

            <TextBlock x:Name="DescriptionText"
                       Grid.Row="1"
                       Width="620"
                       Margin="0,12,0,0"
                       HorizontalAlignment="Left"
                       Foreground="{DynamicResource BrushHeroBody}"
                       FontSize="13"
                       LineHeight="20"
                       Text="{Binding Details.Description}"
                       TextAlignment="Left"
                       TextWrapping="Wrap" />

            <controls:GlassBorder x:Name="NoticeBorder"
                                  Grid.Row="2"
                                  Width="620"
                                  Margin="0,14,0,0"
                                  HorizontalAlignment="Left"
                                  Padding="12,8"
                                  Background="{DynamicResource BrushNotice}"
                                  BorderBrush="{DynamicResource BrushNoticeBorder}"
                                  BorderThickness="1"
                                  CornerRadius="{DynamicResource RadiusNotice}"
                    Visibility="{Binding Details.HasPrerequisiteNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,9,0"
                               VerticalAlignment="Top"
                               Foreground="#F0D6A351"
                               FontSize="14"
                               FontWeight="Bold"
                               Text="!" />
                    <TextBlock Grid.Column="1"
                               Foreground="#E6F5F5F5"
                               FontSize="11.5"
                               LineHeight="17"
                               Text="{Binding Details.PrerequisiteNotice}"
                               TextWrapping="Wrap" />
                </Grid>
            </controls:GlassBorder>

            <Border Grid.Row="3" Height="1" Margin="{DynamicResource DividerMargin}" Background="{DynamicResource BrushDivider}" />

            <!-- Dock: transparent and borderless in dark (same layout as before); a frosted pane in glass. -->
            <controls:GlassBorder x:Name="Dock"
                                  Grid.Row="4"
                                  Padding="{DynamicResource DockPadding}"
                                  Background="{DynamicResource BrushDock}"
                                  BorderBrush="{DynamicResource BrushDockBorder}"
                                  BorderThickness="{DynamicResource DockBorderThickness}"
                                  CornerRadius="{DynamicResource RadiusDock}">
            <StackPanel>
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource BrushTextMuted}" Text="▣" />
                    <TextBlock Margin="7,0,0,0" Foreground="{DynamicResource BrushTextMuted}" FontSize="12.5" Text="{Binding Settings.Text.Application.SupportCaption}" />
                    <TextBlock Foreground="{DynamicResource BrushTextMuted}" FontSize="12.5" Text="{Binding Details.SupportText}" />
                </StackPanel>
                <Border Width="1" Height="13" Margin="20,0" Background="#26FFFFFF" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{DynamicResource BrushTextMuted}" Text="◎" />
                    <TextBlock Margin="7,0,0,0" Foreground="{DynamicResource BrushTextMuted}" FontSize="12.5" Text="{Binding Settings.Text.Application.LanguageCaption}" />
                    <TextBlock Foreground="{DynamicResource BrushTextMuted}" FontSize="12.5" Text="{Binding Details.LanguageText}" />
                </StackPanel>
                <Border Width="1" Height="13" Margin="20,0" Background="#26FFFFFF" />
                <TextBlock Foreground="{DynamicResource BrushTextMuted}" FontSize="12.5" Text="{Binding Details.Subtitle}" />
                <Border Width="1" Height="13" Margin="20,0" Background="#26FFFFFF" />
                <TextBlock Foreground="{DynamicResource BrushTextMuted}" FontSize="12.5" Text="{Binding Settings.Text.Application.VerifiedCaption}" />
                <TextBlock Foreground="{DynamicResource BrushTextMuted}" FontSize="12.5" Text="{Binding Details.VerifiedDateText}" />
            </StackPanel>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border MinWidth="142"
                            Padding="16,10"
                            Background="{DynamicResource BrushPanel}"
                            BorderBrush="{DynamicResource BrushStatBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusCard}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextMuted}" FontSize="18" Text="✓" />
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource BrushTextMuted}" FontSize="10" Text="{Binding Settings.Text.Application.StatusCaption}" />
                                <TextBlock Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" FontWeight="Bold" Text="{Binding Details.TranslationStatusText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border MinWidth="150"
                            Margin="12,0,0,0"
                            Padding="16,10"
                            Background="{DynamicResource BrushPanel}"
                            BorderBrush="{DynamicResource BrushStatBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusCard}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextMuted}" FontSize="18" Text="▣" />
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource BrushTextMuted}" FontSize="10" Text="{Binding Settings.Text.Application.SizeCaption}" />
                                <TextBlock Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" FontWeight="Bold" Text="{Binding Details.PackageSizeText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border MinWidth="170"
                            Margin="12,0,0,0"
                            Padding="16,10"
                            Background="{DynamicResource BrushPanel}"
                            BorderBrush="{DynamicResource BrushStatBorder}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusCard}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource BrushTextMuted}" FontSize="18" Text="✓" />
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource BrushTextMuted}" FontSize="10" Text="{Binding Settings.Text.Application.PackageCaption}" />
                                <TextBlock Foreground="{DynamicResource BrushTextPrimary}" FontSize="11" FontWeight="Bold" Text="{Binding Details.FilesText}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Visibility="{Binding Details.HasTranslationActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Command="{Binding Operations.PrimaryActionCommand}" Style="{StaticResource PrimaryActionButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" FontSize="15" Text="▶" />
                            <TextBlock Text="{Binding Details.PrimaryActionLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="12,0,0,0"
                            Command="{Binding Operations.SecondaryActionCommand}"
                            Style="{StaticResource SecondaryActionButton}"
                            Visibility="{Binding Details.HasSecondaryAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Update"
                                                    Width="17"
                                                    Height="17"
                                                    Margin="0,0,8,0"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="{Binding Details.SecondaryActionLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="12,0,0,0"
                            Command="{Binding Operations.TertiaryActionCommand}"
                            Style="{StaticResource SecondaryActionButton}"
                            Visibility="{Binding Details.HasTertiaryAction, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen"
                                                    Width="17"
                                                    Height="17"
                                                    Margin="0,0,8,0"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="{Binding Details.TertiaryActionLabel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                <Button Command="{Binding Operations.ChooseFolderCommand}"
                        Style="{StaticResource TextActionButton}"
                        Visibility="{Binding Details.HasGameRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0" Text="⌁" />
                        <TextBlock Text="{Binding Details.FolderActionLabel}" />
                    </StackPanel>
                </Button>
                <Button Margin="18,0,0,0"
                        Command="{Binding Operations.UninstallCommand}"
                        Style="{StaticResource DangerTextActionButton}"
                        Visibility="{Binding Operations.CanUninstall, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0" Text="×" />
                        <TextBlock Text="{Binding Settings.Text.Application.UninstallTranslation}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Margin="0,12,0,0"
                       FontSize="11.5"
                       Text="{Binding Operations.OperationMessage}"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Operations.IsOperationError}" Value="True">
                                <Setter Property="Foreground" Value="#FFD28A8A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </StackPanel>
            </controls:GlassBorder>
        </Grid>
    </Grid>
</UserControl>
