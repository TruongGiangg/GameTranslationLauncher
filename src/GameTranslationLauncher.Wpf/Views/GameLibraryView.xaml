<UserControl x:Class="GameTranslationLauncher.Wpf.Views.GameLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GameTranslationLauncher.Wpf.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid x:Name="LibraryContent">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Effect" Value="{x:Null}" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="6" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Operations.ConflictDetails.IsVisible}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="6" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Update.IsUpdateAvailable}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <BlurEffect Radius="6" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="168" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource BrushSidebar}"
                BorderBrush="#80313237"
                BorderThickness="0,0,1,0">
            <Grid Margin="0,22,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,22">
                    <Border Width="68"
                            Height="68"
                            ClipToBounds="True"
                            Background="{StaticResource BrushSidebar}">
                        <Image Width="100"
                               Height="100"
                               Margin="-16,-18,0,0"
                               Source="/Resources/tg-minimal-logo-red.png"
                               Stretch="Fill" />
                    </Border>
                </StackPanel>

                <Border Grid.Row="1"
                        Height="32"
                        Margin="16,0,16,14"
                        Background="#151619"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <materialDesign:PackIcon Kind="Magnify"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="8,0,0,0"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 Foreground="{StaticResource BrushTextMuted}"
                                                 IsHitTestVisible="False" />
                        <TextBox x:Name="GameSearchBox"
                                 Margin="31,0,8,0"
                                 Padding="0"
                                 VerticalContentAlignment="Center"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource BrushTextPrimary}"
                                 CaretBrush="{StaticResource BrushTextPrimary}"
                                 FontSize="11"
                                 Text="{Binding GameSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding SearchGamesPlaceholder}" />
                        <TextBlock Margin="31,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="11"
                                   IsHitTestVisible="False"
                                   Text="{Binding SearchGamesPlaceholder}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=GameSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding FilteredGames}"
                             SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource GameNavigationListBoxItem}"
                             HorizontalContentAlignment="Center"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.PanningMode="VerticalOnly"
                             ScrollViewer.PanningDeceleration="0.0015"
                             ScrollViewer.PanningRatio="1"
                             IsManipulationEnabled="True">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel HorizontalAlignment="Center"
                                                        ScrollUnit="Pixel"
                                                        VirtualizationMode="Recycling" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel ToolTip="{Binding DisplayName}">
                                    <Border Height="58"
                                            Background="{Binding CoverBrush}"
                                            CornerRadius="6"
                                            ClipToBounds="True">
                                        <Grid RenderTransformOrigin="0.5,0.5">
                                            <Grid.RenderTransform>
                                                <ScaleTransform x:Name="ThumbnailScaleTransform" ScaleX="1" ScaleY="1" />
                                            </Grid.RenderTransform>
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                            <Rectangle Fill="#2608090A" RadiusX="6" RadiusY="6" />
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="White"
                                                       FontSize="18"
                                                       FontWeight="Bold"
                                                       Text="{Binding Initials}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CoverImage}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ThumbnailScaleTransform"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         To="1.08" Duration="0:0:0.18">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ThumbnailScaleTransform"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         To="1.08" Duration="0:0:0.18">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ThumbnailScaleTransform"
                                                                         Storyboard.TargetProperty="ScaleX"
                                                                         To="1" Duration="0:0:0.18">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetName="ThumbnailScaleTransform"
                                                                         Storyboard.TargetProperty="ScaleY"
                                                                         To="1" Duration="0:0:0.18">
                                                            <DoubleAnimation.EasingFunction>
                                                                <QuadraticEase EasingMode="EaseOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                    <TextBlock Margin="2,7,2,0"
                                               Foreground="{StaticResource BrushTextPrimary}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Text="{Binding DisplayName}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <StackPanel Grid.Row="3" HorizontalAlignment="Center">
                    <Button Command="{Binding ShowSettingsCommand}"
                            Style="{StaticResource SidebarIconButton}"
                            AutomationProperties.Name="Cài đặt Launcher"
                            ToolTip="{Binding Settings.Text.Title}">
                        <materialDesign:PackIcon Kind="Cog"
                                                 Width="18"
                                                 Height="18"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Margin="0,10,0,0"
                            Style="{StaticResource SidebarIconButton}"
                            AutomationProperties.Name="Thông tin phiên bản"
                            Focusable="False"
                            ToolTipService.InitialShowDelay="0"
                            ToolTipService.ShowDuration="20000">
                        <Button.ToolTip>
                            <ToolTip Placement="Top" Content="{Binding Settings.Text.Application.VersionTooltip}" />
                        </Button.ToolTip>
                        <Viewbox Width="18" Height="18">
                            <Grid Width="24" Height="24">
                                <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                         StrokeThickness="1.8" />
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Text="?" />
                            </Grid>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

            <Grid Grid.Column="1">
            <local:GameDetailsView />
            <Border Background="#8F08090A"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="30"
                               Text="↻">
                        <TextBlock.RenderTransform>
                            <RotateTransform />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0"
                                                         To="360"
                                                         Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Margin="0,12,0,0"
                               Foreground="{StaticResource BrushTextPrimary}"
                               Text="{Binding Settings.Text.Application.CatalogLoading}" />
                </StackPanel>
            </Border>
            </Grid>
        </Grid>

        <Border Panel.ZIndex="10"
                Background="#9508090A"
                Visibility="{Binding IsSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <local:LauncherSettingsView />
        </Border>

        <Border Panel.ZIndex="20"
                Background="#B808090A"
                Visibility="{Binding Operations.IsOperationInProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="420"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource BrushTextPrimary}" FontSize="18" FontWeight="Bold" Text="{Binding Settings.Text.Application.ProcessingTranslation}" />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="12"
                               Text="{Binding Operations.OperationMessage}"
                               TextWrapping="Wrap" />
                    <ProgressBar Margin="0,18,0,0"
                                 Height="7"
                                 Maximum="100"
                                 Value="{Binding Operations.OperationProgress, Mode=OneWay}"
                                 Style="{StaticResource OperationProgressBar}" />
                    <Button Margin="0,22,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding Operations.CancelOperationCommand}"
                            Style="{StaticResource SecondaryActionButton}">
                        <TextBlock Text="{Binding Settings.Text.Application.CancelAfterSafePoint}" />
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <Border Panel.ZIndex="25"
                Background="#B808090A"
                Visibility="{Binding Operations.ConflictDetails.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="560"
                    Padding="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="#8CE2A364"
                    BorderThickness="1"
                    CornerRadius="14"
                    Opacity="0">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="21"
                               FontWeight="Bold"
                               Text="{Binding Operations.ConflictDetails.Title}" />
                    <Button Grid.Column="1"
                            Width="34"
                            Height="34"
                            Padding="0"
                            Command="{Binding Operations.ConflictDetails.CloseCommand}"
                            Style="{StaticResource TextActionButton}"
                            ToolTip="{Binding Settings.Text.CloseLabel}">
                        <TextBlock FontSize="20" FontWeight="Light" Text="×" />
                    </Button>

                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Margin="0,14,0,0"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="13"
                               LineHeight="20"
                               Text="{Binding Operations.ConflictDetails.Message}"
                               TextWrapping="Wrap" />

                    <Border Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Margin="0,18,0,0"
                            Padding="14,12"
                            Background="#251C1D20"
                            BorderBrush="#553E4047"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBlock Foreground="{StaticResource BrushTextPrimary}"
                                   FontSize="12"
                                   LineHeight="18"
                                   Text="{Binding Operations.ConflictDetails.Recommendation}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Margin="0,26,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button Command="{Binding Operations.SecondaryActionCommand}"
                                Style="{StaticResource SecondaryActionButton}">
                            <TextBlock Text="{Binding Settings.Text.Application.SecondaryOpenFolder}" />
                        </Button>
                        <Button Margin="12,0,0,0"
                                Command="{Binding Operations.ConflictDetails.CloseCommand}"
                                Style="{StaticResource PrimaryActionButton}">
                            <TextBlock Text="{Binding Operations.ConflictDetails.AcknowledgeAction}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Border Panel.ZIndex="30"
                Background="#C908090A"
                Visibility="{Binding Operations.IsConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="500"
                    Padding="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="#8CF5F5F5"
                    BorderThickness="1"
                    CornerRadius="14"
                    Opacity="0">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel>
                    <TextBlock Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="21"
                               FontWeight="Bold"
                               Text="{Binding Operations.ConfirmationTitle}" />
                    <TextBlock Margin="0,14,0,0"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="13"
                               LineHeight="20"
                               Text="{Binding Operations.ConfirmationMessage}"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,26,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Command="{Binding Operations.CancelConfirmationCommand}"
                                Style="{StaticResource SecondaryActionButton}">
                            <TextBlock Text="{Binding Settings.Text.Application.Back}" />
                        </Button>
                        <Button Margin="12,0,0,0"
                                Command="{Binding Operations.ConfirmCommand}"
                                Style="{StaticResource PrimaryActionButton}">
                            <TextBlock Text="{Binding Operations.ConfirmationActionLabel}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Panel.ZIndex="40"
                Background="#D808090A"
                Visibility="{Binding Update.IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="520"
                    Padding="30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource BrushPanel}"
                    BorderBrush="#8CF5F5F5"
                    BorderThickness="1"
                    CornerRadius="14"
                    Opacity="0">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel>
                    <TextBlock Foreground="{StaticResource BrushTextPrimary}"
                               FontSize="21"
                               FontWeight="Bold"
                               Text="{Binding Update.LatestVersionLabel}" />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="13"
                               Text="{Binding Update.MandatoryNoticeLabel}"
                               TextWrapping="Wrap" />
                    <Border Margin="0,18,0,0"
                            Padding="14"
                            MaxHeight="220"
                            Background="{StaticResource BrushSidebar}"
                            BorderBrush="#40F5F5F5"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="{Binding Update.ReleaseNotes, Converter={StaticResource StringToVisibilityConverter}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Foreground="{StaticResource BrushTextPrimary}"
                                       FontSize="13"
                                       LineHeight="20"
                                       Text="{Binding Update.ReleaseNotes}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                    <ProgressBar Height="6"
                                 Margin="0,18,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Update.DownloadProgress, Mode=OneWay}"
                                 Visibility="{Binding Update.IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Margin="0,10,0,0"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="12"
                               Text="{Binding Update.StatusMessage}" />
                    <Button Margin="0,20,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding Update.DownloadAndInstallCommand}"
                            Style="{StaticResource PrimaryActionButton}">
                        <TextBlock Text="{Binding Update.DownloadAndInstallLabel}" />
                    </Button>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
