{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:game-translation-launcher:schema:launcher-package:1",
  "title": "Game Translation Launcher package",
  "description": "Hợp đồng package tự chứa để Launcher cài một bản Việt hóa.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gameId",
    "displayName",
    "packageVersion",
    "targetLanguage",
    "lastVerifiedWorkingInGame",
    "installDetection",
    "payloadFiles",
    "prerequisites"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "gameId": {
      "$ref": "#/$defs/gameId"
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "packageVersion": {
      "$ref": "#/$defs/semanticVersion"
    },
    "targetLanguage": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "lastVerifiedWorkingInGame": {
      "type": "string",
      "format": "date"
    },
    "installDetection": {
      "$ref": "#/$defs/installDetection"
    },
    "payloadFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/payloadFile"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prerequisite"
      }
    }
  },
  "$defs": {
    "gameId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 80
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*/$)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*:)[^\\u0000]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "installDetection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredPaths",
        "blockedProcessNames"
      ],
      "properties": {
        "requiredPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "kind"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/relativePath"
              },
              "kind": {
                "enum": [
                  "file",
                  "directory"
                ]
              }
            }
          }
        },
        "blockedProcessNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 260,
            "pattern": "^[^\\\\/:*?\"<>|]+$"
          }
        }
      }
    },
    "payloadFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "destination",
        "sha256",
        "sizeBytes",
        "role"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "destination": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "translation",
            "companion"
          ]
        }
      }
    },
    "prerequisiteFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "destination",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "destination": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "prerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "description",
        "requiresExplicitConsent",
        "files"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/gameId"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "requiresExplicitConsent": {
          "type": "boolean"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/prerequisiteFile"
          }
        }
      }
    }
  }
}
