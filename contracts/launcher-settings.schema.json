{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:game-translation-launcher:schema:launcher-settings:1",
  "title": "Game Translation Launcher settings",
  "description": "Các thư mục game đã được người dùng chọn trên máy hiện tại.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "installations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "displayLanguage": {
      "enum": ["vi", "en"]
    },
    "accentTheme": {
      "enum": ["crimson", "blue", "emerald", "violet", "white", "orange", "cyan"]
    },
    "installations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/installationSetting"
      }
    }
  },
  "$defs": {
    "gameId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "installationSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gameId",
        "installationId",
        "gameRoot",
        "lastUsedAtUtc"
      ],
      "properties": {
        "gameId": {
          "$ref": "#/$defs/gameId"
        },
        "installationId": {
          "type": "string",
          "format": "uuid"
        },
        "gameRoot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32767
        },
        "lastUsedAtUtc": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
